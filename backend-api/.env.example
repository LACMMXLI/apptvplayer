# Server
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Number of reverse-proxy hops in front of the API (e.g. 1 behind Coolify).
# Needed so per-IP rate limiting sees the real client IP. Leave unset when
# the API is reached directly.
# TRUST_PROXY=1

# Max size of an uploaded image/video, in MB.
MAX_UPLOAD_MB=200

# Database
DATABASE_URL=postgresql://signage:signage@localhost:5432/signage?schema=public

# Redis (optional). When set, Socket.io uses the Redis adapter so real-time
# events reach every backend replica — needed once you scale beyond a single
# backend instance. Leave unset for single-instance/local dev.
# REDIS_URL=redis://localhost:6379

# Auth
# Must be at least 32 random characters in production (NODE_ENV=production),
# otherwise the backend refuses to start. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# S3 / MinIO compatible storage
# For local dev these point at the docker-compose MinIO service.
# In production, swap for Cloudflare R2 (or any S3-compatible provider) credentials
# without touching application code.
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_REGION=us-east-1
S3_KEY=minioadmin
S3_SECRET=minioadmin
S3_BUCKET=signage-media
# Public base URL used to build media URLs served to clients (through reverse proxy/CDN)
S3_PUBLIC_URL=http://localhost:9000
