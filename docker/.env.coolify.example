# Variables to set in Coolify's "Environment Variables" tab for the
# docker-compose.coolify.yml resource. Nothing here is hardcoded in the
# compose file itself — copy these keys into Coolify and fill in real values.

# --- Postgres ---
POSTGRES_USER=signage
POSTGRES_PASSWORD=                 # generate a strong random value
POSTGRES_DB=signage

# --- MinIO (S3-compatible storage) ---
S3_KEY=                            # MinIO root user / access key
S3_SECRET=                         # MinIO root password / secret key (generate)
S3_REGION=us-east-1
S3_BUCKET=signage-media
S3_PUBLIC_URL=https://storage-signage.fatboymexicali.com

# --- Backend API ---
JWT_SECRET=                        # generate a long random value
JWT_EXPIRES_IN=7d
CORS_ORIGINS=https://signage.fatboymexicali.com,https://tv.fatboymexicali.com

# --- Frontends (build-time + runtime) ---
API_URL=https://api-signage.fatboymexicali.com/api
WS_URL=https://api-signage.fatboymexicali.com
