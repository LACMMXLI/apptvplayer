# Variables for the separate Coolify resources. Set each only on the resource
# named in its section; generate new, strong credentials for production.

# --- Postgres resource and backend resource ---
POSTGRES_USER=signage
POSTGRES_PASSWORD=                 # generate a strong random value
POSTGRES_DB=signage

# --- RustFS S3-compatible storage: rustfs resource and backend resource ---
S3_KEY=                            # generate a unique access key
S3_SECRET=                         # generate a unique secret key
S3_REGION=us-east-1
S3_BUCKET=signage-media
S3_PUBLIC_URL=https://storage-signage.fatboymexicali.com # backend only

# --- Backend API ---
JWT_SECRET=                        # REQUIRED, min 32 chars — the backend refuses to start otherwise.
                                   # node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TRUST_PROXY=1                      # proxy hops in front of the backend (needed for per-IP rate limiting)
MAX_UPLOAD_MB=200                  # max size of an uploaded image/video
JWT_EXPIRES_IN=7d
CORS_ORIGINS=https://signage.fatboymexicali.com,https://tv.fatboymexicali.com

# --- Frontends (build-time + runtime) ---
API_URL=https://api-signage.fatboymexicali.com/api
WS_URL=https://api-signage.fatboymexicali.com
ADMIN_URL=https://signage.fatboymexicali.com
