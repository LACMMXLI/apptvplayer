# Root .env consumed by docker/docker-compose.yml for local development.
# Copy to `.env` in this same directory (or export these vars in your shell)
# before running `docker compose -f docker/docker-compose.yml up`.

# --- Postgres ---
POSTGRES_USER=signage
POSTGRES_PASSWORD=signage
POSTGRES_DB=signage
POSTGRES_PORT=5432

# --- MinIO (S3-compatible storage) ---
S3_KEY=minioadmin
S3_SECRET=minioadmin
S3_REGION=us-east-1
S3_BUCKET=signage-media
S3_PUBLIC_URL=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Redis (optional, reserved for future use e.g. caching/queues) ---
REDIS_PORT=6379

# --- Backend API ---
BACKEND_PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Frontends (used only by the `--profile full` containerized build) ---
API_URL=http://localhost:3000/api
WS_URL=http://localhost:3000
ADMIN_PORT=8081
PLAYER_PORT=8082
