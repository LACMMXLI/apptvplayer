# Base URL of backend-api, no trailing slash
VITE_API_URL=http://localhost:3000/api
# WebSocket URL of backend-api (Socket.io), no trailing slash
VITE_WS_URL=http://localhost:3000
# Public URL of the admin panel, no trailing slash (optional). When set, the
# pairing screen shows a QR code that opens the panel with the code pre-filled.
VITE_ADMIN_URL=http://localhost:5173
